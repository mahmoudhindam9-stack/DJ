<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center_vertical" android:padding="12dp" android:background="@drawable/widget_bg">
    <TextView android:id="@+id/quick_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="مشغل الموسيقى" android:textColor="@android:color/white" android:textSize="15sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
    <TextView android:id="@+id/quick_artist" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="موسيقى" android:textColor="#BBBBBB" android:textSize="11sp" android:maxLines="1" android:ellipsize="end" />
    <TextView android:id="@+id/quick_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="⏸ Paused" android:textColor="#BBBBBB" android:textSize="10sp" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:orientation="horizontal" android:layout_marginTop="6dp">
        <ImageButton android:id="@+id/quick_prev" android:layout_width="42dp" android:layout_height="42dp" android:background="@android:drawable/list_selector_background" android:src="@android:drawable/ic_media_previous" android:contentDescription="Previous" />
        <ImageButton android:id="@+id/quick_play" android:layout_width="50dp" android:layout_height="50dp" android:layout_marginHorizontal="12dp" android:background="@android:drawable/list_selector_background" android:src="@android:drawable/ic_media_play" android:contentDescription="Play/Pause" />
        <ImageButton android:id="@+id/quick_next" android:layout_width="42dp" android:layout_height="42dp" android:background="@android:drawable/list_selector_background" android:src="@android:drawable/ic_media_next" android:contentDescription="Next" />
    </LinearLayout>
</LinearLayout>
