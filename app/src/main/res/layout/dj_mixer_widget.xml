<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="10dp" android:background="@drawable/widget_bg">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="PRO DJ MIXER" android:textColor="@android:color/white" android:textStyle="bold" android:textSize="12sp" />
    <TextView android:id="@+id/deck_a_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Deck A — Empty" android:textColor="@android:color/white" android:textSize="12sp" android:maxLines="1" android:ellipsize="end" android:layout_marginTop="6dp" />
    <TextView android:id="@+id/deck_a_artist" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Load a track" android:textColor="#AAAAAA" android:textSize="10sp" android:maxLines="1" android:ellipsize="end" />
    <TextView android:id="@+id/deck_b_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Deck B — Empty" android:textColor="@android:color/white" android:textSize="12sp" android:maxLines="1" android:ellipsize="end" android:layout_marginTop="6dp" />
    <TextView android:id="@+id/deck_b_artist" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Load a track" android:textColor="#AAAAAA" android:textSize="10sp" android:maxLines="1" android:ellipsize="end" />
    <Button android:id="@+id/dj_widget_open" android:layout_width="match_parent" android:layout_height="36dp" android:text="Open DJ Mixer" android:textSize="11sp" android:layout_marginTop="6dp" />
</LinearLayout>
